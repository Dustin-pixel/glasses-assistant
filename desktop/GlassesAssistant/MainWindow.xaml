<Window x:Class="GlassesAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glasses Assistant" Width="780" Height="760" MinWidth="540" MinHeight="560"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0F1517" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#172023" />
        <SolidColorBrush x:Key="TextBrush" Color="#E3ECEE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3FB7C1" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <!-- Header: mode, character, and the "eyepiece" display -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Glasses Assistant" FontSize="24" FontWeight="SemiBold" />
            <WrapPanel Margin="0,10,0,0">
                <RadioButton x:Name="ModeAssist" GroupName="mode" Content="Assistant" Checked="Mode_Checked" />
                <RadioButton x:Name="ModeArgue" GroupName="mode" Content="Argue" Checked="Mode_Checked" />
            </WrapPanel>
            <WrapPanel x:Name="SkinPanel" Margin="0,4,0,0" />

            <Border x:Name="Hud" Margin="0,8,0,0" Padding="16,12" CornerRadius="10" MinHeight="120"
                    Background="#FF050A0B" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="HudTitle" FontFamily="Consolas" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}" Text="READY" />
                    <TextBlock x:Name="HudText" FontFamily="Consolas" FontSize="17" Margin="0,6,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="HudBig" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer: input, controls, settings -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <DockPanel>
                <Button x:Name="TalkButton" DockPanel.Dock="Left" Content="🎤 Talk" Click="Talk_Click" />
                <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Click="Send_Click" Margin="8,0,0,0" />
                <TextBox x:Name="Input" KeyDown="Input_KeyDown" VerticalContentAlignment="Center" />
            </DockPanel>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="KeepButton" Content="Keep arguing" Click="Keep_Click" />
                <Button x:Name="NewButton" Content="New argument" Click="New_Click" />
                <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" />
                <CheckBox x:Name="SpeakBox" Content="Speak replies" VerticalAlignment="Center" Margin="4,0,0,0"
                          Foreground="{DynamicResource TextBrush}" Checked="Speak_Changed" Unchecked="Speak_Changed" />
            </WrapPanel>
            <Expander x:Name="SettingsExpander" Header="Settings" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="Claude API key" />
                    <PasswordBox x:Name="KeyBox" Margin="0,2,0,0" />
                    <TextBlock Text="Model" Margin="0,8,0,0" />
                    <TextBox x:Name="ModelBox" Margin="0,2,0,0" />
                    <Button Content="Save" Click="Save_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <TextBlock Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap"
                               Text="Ctrl+Alt+Space talks from anywhere, even when this window is in the background." />
                </StackPanel>
            </Expander>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" Opacity="0.85" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Transcript -->
        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <ItemsControl x:Name="Log">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Who}" FontWeight="SemiBold" Foreground="{Binding Brush}" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
